{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "adviser",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "advisor_uy_db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "./migrations"
    }
  ],

  // R2 bucket for persistent document storage (tax period uploads).
  // Create with: npx wrangler r2 bucket create adviser-documents
  "r2_buckets": [
    {
      "binding": "DOCUMENTS_BUCKET",
      "bucket_name": "adviser-documents"
    }
  ],

  // Vectorize semantic index.
  // Create with: npx wrangler vectorize create advisor-uy-index --dimensions=1024 --metric=cosine
  // Model: @cf/baai/bge-m3 (multilingual, 1024 dims) — supports Spanish legal corpus.
  // NOTE: if upgrading from bge-base-en-v1.5 (768 dims), recreate the index and re-ingest all documents.
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "advisor-uy-index"
    }
  ],

  "ai": {
    "binding": "AI"
  },

  // Cloudflare Browser Rendering – powers DGI/BPS portal automation.
  // Enable with: npx wrangler browser render enable  (requires paid plan)
  "browser": {
    "binding": "BROWSER"
  },

  // Workers Rate Limiting – 20 requests per IP per 60 seconds
  // Run: no extra setup needed; the namespace_id is a local label.
  "rate_limiting": [
    {
      "binding": "RATE_LIMITER",
      "namespace_id": 1001,
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],

  // Cloudflare Email Send binding (beta).
  // Add `allowed_destination_addresses` to restrict recipients, or
  // `default_from` to pin the sender.
  "send_email": [
    {
      "name": "EMAIL_SEND"
    }
  ],

  // Secrets (set via `wrangler secret put <NAME>`):
  //   EMAIL_FROM              – Verified sender address, e.g. "noreply@yourdomain.com"
  //   EMAIL_API_KEY           – Resend API key (fallback, only needed without EMAIL_SEND binding)
  //   PORTAL_ENCRYPTION_KEY   – 64-char hex string (32 bytes) for AES-256-GCM encryption of
  //                             DGI/BPS portal session cookies. Generate with:
  //                             node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

  // -------------------------------------------------------------------------
  // Develop environment – separate Worker + D1 + Vectorize index
  // -------------------------------------------------------------------------
  "env": {
    "develop": {
      "name": "adviser-develop",

      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "advisor_uy_db_develop",
          "database_id": "REPLACE_WITH_DEVELOP_D1_DATABASE_ID",
          "migrations_dir": "./migrations"
        }
      ],

      "r2_buckets": [
        {
          "binding": "DOCUMENTS_BUCKET",
          "bucket_name": "adviser-documents-develop"
        }
      ],

      "vectorize": [
        {
          "binding": "VECTORIZE",
          "index_name": "advisor-uy-index-develop"
        }
      ],

      "rate_limiting": [
        {
          "binding": "RATE_LIMITER",
          "namespace_id": 1002,
          "simple": {
            "limit": 20,
            "period": 60
          }
        }
      ]

      // Secrets for develop are set with:
      //   wrangler secret put EMAIL_FROM    --env develop
      //   wrangler secret put EMAIL_API_KEY --env develop  (fallback, without EMAIL_SEND binding)
    }
  }
}
