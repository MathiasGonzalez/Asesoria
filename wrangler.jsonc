{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uy-tax-adviser",
  "main": "src/index.ts",
  "compatibility_date": "2024-01-10",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uy_tax_db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "./migrations"
    }
  ],
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "uy-tax-index"
    }
  ],
  "ai": {
    "binding": "AI"
  }
}
