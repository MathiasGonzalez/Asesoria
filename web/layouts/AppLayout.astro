---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Adviser</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,700;0,800;1,600;1,700&display=swap" />
    <style>
      :root {
        --font-display: 'Playfair Display', Georgia, serif;
        --color-bg: #f6f5f2;
        --color-accent: #4f46e5;
        --color-gold: #c8992a;
      }
      body { font-family: 'Inter', system-ui, sans-serif; background-color: var(--color-bg); -webkit-font-smoothing: antialiased; }
    </style>
  </head>
  <body class="text-[#0f1117] antialiased">
    <nav style="background: rgba(255,255,255,0.9); backdrop-filter: blur(20px) saturate(180%); border-bottom: 1px solid rgba(0,0,0,0.08); box-shadow: 0 1px 0 rgba(0,0,0,0.04);" class="px-6 py-3.5 flex items-center justify-between sticky top-0 z-10">
      <a href="/app" class="font-bold text-xl tracking-tight" style="font-family: var(--font-display); color: #0f1117; letter-spacing: -0.03em;">Adviser<span style="color: #c8992a;">.</span></a>
      <div class="flex items-center gap-4">
        <span id="user-email" class="text-xs hidden" style="color: #6b7280;"></span>
        <button
          id="logout-btn"
          class="hidden text-xs font-medium transition-colors px-3 py-1.5 rounded-lg"
          style="color: #dc2626;"
          onmouseover="this.style.background='rgba(220,38,38,0.07)'"
          onmouseout="this.style.background='transparent'"
        >
          Cerrar sesión
        </button>
      </div>
    </nav>

    <main class="max-w-4xl mx-auto px-6 py-8 flex flex-col gap-6">
      <slot />
    </main>

    <script>
      // ---------------------------------------------------------------------------
      // Auth guard – redirect to /login if no session token is stored
      // ---------------------------------------------------------------------------
      const session = localStorage.getItem("adviser_session");
      if (!session) {
        window.location.replace("/login?login=required");
      }

      // Show user email from the /api/feature-flags endpoint (which validates the token)
      const emailEl  = document.getElementById("user-email");
      const logoutBtn = document.getElementById("logout-btn");

      async function initSession() {
        if (!session) return;
        try {
          const res = await fetch("/api/feature-flags", {
            headers: { Authorization: "Bearer " + session },
          });
          if (res.status === 401) {
            localStorage.removeItem("adviser_session");
            window.location.replace("/login?login=expired");
            return;
          }
        } catch {
          // Network error – allow offline use
        }
      }

      initSession();

      // Display email from decoded session info stored after login
      const storedEmail = sessionStorage.getItem("adviser_email");
      if (storedEmail && emailEl) {
        emailEl.textContent = storedEmail;
        emailEl.classList.remove("hidden");
      }

      if (logoutBtn) {
        logoutBtn.classList.remove("hidden");
        logoutBtn.addEventListener("click", async () => {
          const tok = localStorage.getItem("adviser_session");
          if (tok) {
            await fetch("/api/auth/logout", {
              method: "POST",
              headers: { Authorization: "Bearer " + tok },
            }).catch(() => {});
          }
          localStorage.removeItem("adviser_session");
          sessionStorage.removeItem("adviser_email");
          window.location.replace("/login");
        });
      }

      // Expose helper so pages can attach the auth header to fetch calls
      (window as any).__authHeader = () =>
        session ? { Authorization: "Bearer " + session } : {};
    </script>
  </body>
</html>
