---
import '../styles/global.css';
interface Props {
  title: string;
  description?: string;
}
const { title, description = "Adviser — Plataforma inteligente de asesoramiento regulatorio DGI y BPS para Uruguay. Cumple Art. 47 Código Tributario y URCDP Ley 18.331." } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} — Adviser</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,700;0,800;1,600;1,700&display=swap" />
  </head>
  <body class="text-[#0f1117] antialiased">
    <slot />
  </body>
</html>
