---
---
<section class="relative overflow-hidden bg-gradient-to-br from-slate-900 via-blue-950 to-slate-900 text-white py-24">
  <!-- Background decoration -->
  <div class="absolute inset-0 opacity-10 pointer-events-none" aria-hidden="true">
    <div class="absolute top-0 -left-4 w-72 h-72 bg-blue-500 rounded-full mix-blend-multiply filter blur-3xl"></div>
    <div class="absolute bottom-0 right-0 w-96 h-96 bg-indigo-500 rounded-full mix-blend-multiply filter blur-3xl"></div>
  </div>

  <div class="relative max-w-5xl mx-auto px-6 flex flex-col items-center text-center gap-8">
    <!-- Compliance badges -->
    <div class="flex flex-wrap justify-center gap-2">
      <span class="inline-flex items-center gap-1.5 bg-white/10 border border-white/20 text-blue-200 text-xs font-semibold px-3 py-1.5 rounded-full">
        <svg class="w-3 h-3 text-blue-300" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 1a4.5 4.5 0 00-4.5 4.5V9H5a2 2 0 00-2 2v6a2 2 0 002 2h10a2 2 0 002-2v-6a2 2 0 00-2-2h-.5V5.5A4.5 4.5 0 0010 1zm3 8V5.5a3 3 0 10-6 0V9h6z" clip-rule="evenodd"/></svg>
        Art. 47 Secreto Tributario
      </span>
      <span class="inline-flex items-center gap-1.5 bg-white/10 border border-white/20 text-green-200 text-xs font-semibold px-3 py-1.5 rounded-full">
        <svg class="w-3 h-3 text-green-300" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
        URCDP · Ley 18.331
      </span>
      <span class="inline-flex items-center gap-1.5 bg-white/10 border border-white/20 text-orange-200 text-xs font-semibold px-3 py-1.5 rounded-full">
        <svg class="w-3 h-3 text-orange-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        Normativa DGI · BPS Oficial
      </span>
    </div>

    <!-- Main headline -->
    <h1 class="text-5xl sm:text-6xl font-extrabold leading-tight tracking-tight max-w-4xl">
      Asesoría Tributaria
      <span class="bg-gradient-to-r from-blue-400 to-cyan-300 bg-clip-text text-transparent"> Inteligente</span>
      <br class="hidden sm:block" /> para Uruguay
    </h1>

    <p class="text-blue-100/80 text-xl max-w-2xl leading-relaxed font-light">
      Respuestas grounded en normativa oficial DGI y BPS, con anonimización automática de datos sensibles y cumplimiento del secreto tributario uruguayo.
    </p>

    <!-- CTA buttons -->
    <div class="flex flex-col sm:flex-row gap-4 mt-2">
      <a
        href="#acceso"
        class="group inline-flex items-center gap-2 bg-white text-blue-900 font-bold px-8 py-3.5 rounded-xl hover:bg-blue-50 transition-all shadow-lg text-sm"
      >
        Solicitar acceso
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
      </a>
      <a
        href="#funcionalidades"
        class="inline-flex items-center gap-2 border border-white/30 text-white font-medium px-8 py-3.5 rounded-xl hover:bg-white/10 transition-all text-sm"
      >
        Ver funcionalidades
      </a>
    </div>

    <!-- Trust indicators -->
    <div class="flex flex-wrap justify-center gap-6 pt-4 text-xs text-blue-300/70 border-t border-white/10 w-full">
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        Edge inference en Cloudflare
      </span>
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        Sin contraseñas — OTP por email
      </span>
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        PII anonimizada antes del modelo
      </span>
    </div>
  </div>
</section>
