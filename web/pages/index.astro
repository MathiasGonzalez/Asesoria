---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Features from "../components/Features.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout title="Inicio">
  <!-- Public navbar -->
  <nav class="bg-white/95 backdrop-blur-sm border-b border-slate-200 px-6 py-3 flex items-center justify-between sticky top-0 z-50 shadow-sm">
    <span class="font-extrabold text-slate-900 text-lg tracking-tight">
      Adviser<span class="text-blue-600">.</span>
    </span>
    <div class="flex items-center gap-4">
      <a href="#funcionalidades" class="hidden sm:inline text-sm text-slate-600 hover:text-slate-900 transition-colors">Funcionalidades</a>
      <a href="#acceso" class="hidden sm:inline text-sm text-slate-600 hover:text-slate-900 transition-colors">Acceso</a>
      <a
        id="cta-btn"
        href="/login"
        class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-5 py-2 rounded-lg transition-colors shadow-sm"
      >
        Acceder
      </a>
    </div>
  </nav>

  <Hero />

  <div id="funcionalidades">
    <Features />
  </div>

  <!-- Compliance section -->
  <section class="py-16 bg-slate-50 border-y border-slate-200">
    <div class="max-w-5xl mx-auto px-6">
      <div class="text-center mb-10">
        <span class="inline-block text-xs font-semibold text-green-700 bg-green-100 px-3 py-1.5 rounded-full mb-4 uppercase tracking-wider">
          Cumplimiento legal
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-3">Diseñado para cumplir la normativa uruguaya</h2>
        <p class="text-slate-500 max-w-xl mx-auto text-sm">Requisitos legales no son opcionales — están integrados en la arquitectura del sistema.</p>
      </div>
      <div class="grid sm:grid-cols-3 gap-6">
        {[
          {
            title: "Art. 47 Código Tributario",
            desc: "Secreto tributario: la información de contribuyentes no puede ser divulgada. Adviser anonimiza RUTs, CIs y montos antes de cualquier procesamiento.",
            icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>`,
            color: "text-blue-700 bg-blue-100",
          },
          {
            title: "URCDP · Ley 18.331",
            desc: "Protección de datos personales: ningún dato identificable se almacena en vectores ni logs. La sanitización ocurre en memoria, antes de la inferencia.",
            icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`,
            color: "text-green-700 bg-green-100",
          },
          {
            title: "Respuestas Grounded",
            desc: "El modelo sólo puede responder desde el corpus normativo oficial ingresado. Sin alucinaciones: cada respuesta cita la fuente legislativa verificable.",
            icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>`,
            color: "text-orange-700 bg-orange-100",
          },
        ].map((item) => (
          <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm flex flex-col gap-4">
            <div class={`w-10 h-10 rounded-xl flex items-center justify-center ${item.color}`} set:html={item.icon} />
            <div>
              <h3 class="font-bold text-slate-900 mb-2">{item.title}</h3>
              <p class="text-sm text-slate-500 leading-relaxed">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="py-20 bg-white">
    <div class="max-w-5xl mx-auto px-6">
      <div class="text-center mb-14">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-3">¿Cómo funciona?</h2>
        <p class="text-slate-500 text-sm">Tres pasos para obtener asesoramiento tributario fundamentado.</p>
      </div>
      <ol class="grid sm:grid-cols-3 gap-10">
        {[
          { n: "01", title: "Ingresá tu email", desc: "Recibís un código OTP de un solo uso. No hace falta recordar contraseñas. El primer acceso crea tu cuenta automáticamente." },
          { n: "02", title: "Realizá tu consulta", desc: "Escribís tu pregunta sobre normativa DGI o BPS. Los datos sensibles (CI, RUT, montos) se redactan automáticamente." },
          { n: "03", title: "Respuesta fundamentada", desc: "La IA genera la respuesta basada exclusivamente en normativa oficial, con cita y enlace a la fuente legislativa." },
        ].map((step) => (
          <li class="flex flex-col gap-4">
            <div class="flex items-center gap-4">
              <span class="text-4xl font-extrabold text-blue-100 leading-none">{step.n}</span>
              <div class="h-px flex-1 bg-slate-200"></div>
            </div>
            <h3 class="font-bold text-slate-900 text-lg">{step.title}</h3>
            <p class="text-sm text-slate-500 leading-relaxed">{step.desc}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- CTA section -->
  <section id="acceso" class="py-20 bg-gradient-to-br from-blue-600 to-blue-800 text-white">
    <div class="max-w-2xl mx-auto px-6 text-center flex flex-col gap-6">
      <div class="flex justify-center gap-2 flex-wrap">
        <span class="text-xs bg-white/20 text-blue-100 px-3 py-1 rounded-full">Art. 47 Compliance</span>
        <span class="text-xs bg-white/20 text-blue-100 px-3 py-1 rounded-full">URCDP Ley 18.331</span>
        <span class="text-xs bg-white/20 text-blue-100 px-3 py-1 rounded-full">Cloudflare Edge</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold">Empezá ahora</h2>
      <p class="text-blue-100 text-lg">
        La primera vez que ingresás con tu email se crea tu cuenta automáticamente. Sin formularios ni contraseñas.
      </p>
      <div class="flex justify-center">
        <a
          href="/login"
          class="group inline-flex items-center gap-2 bg-white text-blue-700 font-bold rounded-xl px-10 py-4 text-sm hover:bg-blue-50 transition-all shadow-lg"
        >
          Acceder con email
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<script>
  // If already authenticated, update CTA to go directly to the app
  if (localStorage.getItem("adviser_session")) {
    const btn = document.getElementById("cta-btn") as HTMLAnchorElement | null;
    if (btn) {
      btn.href = "/app";
      btn.textContent = "Ir al asistente";
    }
  }
</script>
