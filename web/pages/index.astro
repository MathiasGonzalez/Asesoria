---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Features from "../components/Features.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout title="Inicio">
  <!-- Public navbar -->
  <nav class="bg-white border-b border-slate-200 px-6 py-3 flex items-center justify-between sticky top-0 z-10 shadow-sm">
    <span class="font-bold text-blue-600 text-lg tracking-tight">Asesoría DGI/BPS</span>
    <a
      id="cta-btn"
      href="/login"
      class="bg-blue-600 hover:bg-blue-700 text-white text-xs font-medium px-4 py-2 rounded-lg transition-colors"
    >
      Acceder
    </a>
  </nav>

  <Hero />

  <div id="funcionalidades">
    <Features />
  </div>

  <!-- How it works -->
  <section class="py-16 bg-slate-50">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="text-2xl font-bold text-slate-800 text-center mb-10">¿Cómo funciona?</h2>
      <ol class="grid sm:grid-cols-3 gap-8">
        {[
          { n: "1", title: "Ingresá tu email",       desc: "Recibís un código de un solo uso (OTP). No hace falta recordar contraseñas." },
          { n: "2", title: "Realizá tu consulta",    desc: "Escribís tu pregunta sobre normativa DGI o BPS. PII redactada automáticamente antes del procesamiento." },
          { n: "3", title: "Respuesta fundamentada", desc: "La IA genera la respuesta basada exclusivamente en normativa oficial, con cita y enlace a la fuente." },
        ].map((step) => (
          <li class="flex flex-col items-center text-center gap-3">
            <span class="w-10 h-10 rounded-full bg-blue-600 text-white font-bold flex items-center justify-center text-lg">
              {step.n}
            </span>
            <h3 class="font-semibold text-slate-800">{step.title}</h3>
            <p class="text-sm text-slate-600">{step.desc}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- CTA section -->
  <section id="acceso" class="py-16 bg-white text-center">
    <div class="max-w-md mx-auto px-6 flex flex-col gap-5">
      <h2 class="text-2xl font-bold text-slate-800">Empezá ahora</h2>
      <p class="text-sm text-slate-600">
        La primera vez que ingresás con tu email se crea tu cuenta automáticamente.
      </p>
      <a
        href="/login"
        class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg px-8 py-3 text-sm transition-colors"
      >
        Acceder con email →
      </a>
    </div>
  </section>

  <Footer />
</BaseLayout>

<script>
  // If already authenticated, update CTA to go directly to the app
  if (localStorage.getItem("uy_tax_session")) {
    const btn = document.getElementById("cta-btn") as HTMLAnchorElement | null;
    if (btn) {
      btn.href = "/app";
      btn.textContent = "Ir al asistente";
    }
  }
</script>
