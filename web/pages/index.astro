---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Footer from "../components/Footer.astro";

const examples = [
  {
    tag: "IRAE · Empresa Unipersonal",
    tagColor: "#4f46e5",
    tagBg: "rgba(79,70,229,0.08)",
    question: "¿Una empresa unipersonal con ingresos anuales menores a 305.000 UI debe tributar IRAE obligatoriamente?",
    answer: "No. Con ingresos por debajo de las 305.000 UI anuales, la empresa unipersonal puede optar por tributar IRPF Categoría II en lugar de IRAE. La elección debe ejercerse al inicio de actividades o al comienzo de cada ejercicio.",
    sources: "Art. 52, Ley 18.083 · Arts. 3–6, Decreto 150/007",
  },
  {
    tag: "BPS · Alta como Empleador",
    tagColor: "#059669",
    tagBg: "rgba(5,150,105,0.08)",
    question: "¿Cuándo nace la obligación de inscribirme en BPS como empleador? ¿Puedo esperar a tener el contrato firmado?",
    answer: "La obligación surge desde el primer día en que una persona presta servicios bajo dependencia, independientemente del monto o duración del vínculo. El registro debe realizarse antes del inicio de la relación laboral, no al firmar el contrato.",
    sources: "Art. 3, Decreto 318/991 · Art. 1, Ley 16.713",
  },
  {
    tag: "DGI · Prescripción Tributaria",
    tagColor: "#c8992a",
    tagBg: "rgba(200,153,42,0.08)",
    question: "DGI me reclama una deuda por IVA de hace 7 años que nunca me notificaron. ¿Sigue siendo válida?",
    answer: "El plazo de prescripción general es de 5 años desde que el tributo fue exigible. Si DGI no realizó actos interruptivos documentados (notificaciones, auditorías) dentro de ese plazo, la obligación estaría prescripta. El plazo se extiende a 10 años únicamente en casos de dolo comprobado.",
    sources: "Arts. 38–42, Código Tributario Uruguayo",
  },
];
---

<BaseLayout title="Inicio">
  <!-- Public navbar -->
  <nav style="background: rgba(255,255,255,0.85); backdrop-filter: blur(20px) saturate(180%); border-bottom: 1px solid rgba(0,0,0,0.08); box-shadow: 0 1px 0 rgba(0,0,0,0.04);" class="px-6 py-3.5 flex items-center justify-between sticky top-0 z-50">
    <span class="font-bold text-xl tracking-tight" style="font-family: var(--font-display), Georgia, serif; color: #0f1117; letter-spacing: -0.03em;">
      Adviser<span style="color: #c8992a;">.</span>
    </span>
    <div class="flex items-center gap-5">
      <a href="#ejemplos" class="hidden sm:inline text-sm font-medium transition-colors" style="color: #6b7280;" onmouseover="this.style.color='#0f1117'" onmouseout="this.style.color='#6b7280'">Ejemplos</a>
      <a href="#acceso" class="hidden sm:inline text-sm font-medium transition-colors" style="color: #6b7280;" onmouseover="this.style.color='#0f1117'" onmouseout="this.style.color='#6b7280'">Acceso</a>
      <a
        id="cta-btn"
        href="/login"
        class="text-white text-sm font-semibold px-5 py-2 rounded-lg transition-all"
        style="background: #4f46e5; box-shadow: 0 1px 6px rgba(79,70,229,0.3);"
        onmouseover="this.style.background='#4338ca'; this.style.boxShadow='0 4px 12px rgba(79,70,229,0.4)'; this.style.transform='translateY(-1px)';"
        onmouseout="this.style.background='#4f46e5'; this.style.boxShadow='0 1px 6px rgba(79,70,229,0.3)'; this.style.transform='';"
      >
        Acceder
      </a>
    </div>
  </nav>

  <Hero />

  <div id="ejemplos">

    <!-- Usage examples section -->
    <section class="py-24" style="background-color: #f6f5f2;">
      <div class="max-w-5xl mx-auto px-6">
        <div class="text-center mb-16">
          <span class="section-eyebrow mb-5" style="color: #4f46e5; background: rgba(79,70,229,0.08);">
            Ejemplos reales
          </span>
          <h2 class="font-display text-3xl sm:text-4xl font-bold mb-4 mt-4"
            style="font-family: var(--font-display), Georgia, serif; color: #0f1117; letter-spacing: -0.02em;">
            Preguntas que podés hacer hoy
          </h2>
          <p class="text-lg max-w-2xl mx-auto" style="color: #6b7280; line-height: 1.7;">
            Respuestas fundamentadas en normativa oficial DGI y BPS. Cada respuesta cita la fuente legislativa exacta.
          </p>
        </div>

        <!-- Example cards -->
        <div class="flex flex-col gap-5">
          {examples.map((ex) => (
            <div class="overflow-hidden" style="background: white; border-radius: 1.125rem; border: 1px solid rgba(0,0,0,0.07); box-shadow: 0 2px 12px rgba(0,0,0,0.04);">
              <!-- Card header -->
              <div class="px-6 py-3 flex items-center justify-between" style="background: #fafaf9; border-bottom: 1px solid rgba(0,0,0,0.06);">
                <span class="text-xs font-semibold px-3 py-1 rounded-full"
                  style={`color: ${ex.tagColor}; background: ${ex.tagBg};`}>
                  {ex.tag}
                </span>
                <span class="text-xs" style="color: #9ca3af;">Ejemplo de consulta</span>
              </div>

              <!-- Q&A body -->
              <div class="p-6 grid sm:grid-cols-2 gap-5">
                <!-- Question -->
                <div class="flex flex-col gap-3">
                  <div class="flex items-center gap-2">
                    <div class="w-5 h-5 rounded-full flex items-center justify-center"
                      style="background: #e5e7eb;">
                      <svg class="w-3 h-3" fill="currentColor" style="color: #6b7280;" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/>
                      </svg>
                    </div>
                    <span class="text-xs font-semibold" style="color: #6b7280; letter-spacing: 0.02em;">Consulta</span>
                  </div>
                  <div class="rounded-xl p-4 text-sm leading-relaxed" style="background: #f3f4f6; color: #1f2937;">
                    "{ex.question}"
                  </div>
                </div>

                <!-- Answer -->
                <div class="flex flex-col gap-3">
                  <div class="flex items-center gap-2">
                    <div class="w-5 h-5 rounded-full flex items-center justify-center"
                      style="background: rgba(79,70,229,0.12);">
                      <svg class="w-3 h-3" fill="currentColor" style="color: #4f46e5;" viewBox="0 0 20 20">
                        <path d="M11 3a1 1 0 10-2 0v1a1 1 0 102 0V3zM15.657 5.757a1 1 0 00-1.414-1.414l-.707.707a1 1 0 001.414 1.414l.707-.707zM18 10a1 1 0 01-1 1h-1a1 1 0 110-2h1a1 1 0 011 1zM5.05 6.464A1 1 0 106.464 5.05l-.707-.707a1 1 0 00-1.414 1.414l.707.707zM5 10a1 1 0 01-1 1H3a1 1 0 110-2h1a1 1 0 011 1zM8 16v-1h4v1a2 2 0 11-4 0zM12 14c.015-.047.032-.095.051-.142A8.013 8.013 0 0015 8H5a8.013 8.013 0 002.949 5.858A1.978 1.978 0 018 14h4z"/>
                      </svg>
                    </div>
                    <span class="text-xs font-semibold" style="color: #4f46e5; letter-spacing: 0.02em;">Adviser</span>
                  </div>
                  <div class="rounded-xl p-4 flex flex-col gap-3"
                    style="background: white; border: 1.5px solid rgba(79,70,229,0.15); box-shadow: 0 1px 6px rgba(79,70,229,0.06);">
                    <p class="text-sm leading-relaxed" style="color: #1f2937;">{ex.answer}</p>
                    <div class="flex items-start gap-1.5 pt-2 text-xs"
                      style="border-top: 1px solid rgba(0,0,0,0.06); color: #6b7280;">
                      <svg class="w-3.5 h-3.5 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                      </svg>
                      <span class="font-mono" style="font-size: 0.7rem;">{ex.sources}</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Disclaimer -->
        <p class="text-center text-xs mt-8" style="color: #9ca3af;">
          Las respuestas del asistente son orientativas. Consultá siempre con un contador o asesor tributario habilitado para situaciones específicas.
        </p>
      </div>
    </section>

    <!-- Compact features strip -->
    <section style="background: white; border-top: 1px solid rgba(0,0,0,0.06); border-bottom: 1px solid rgba(0,0,0,0.06);">
      <div class="max-w-5xl mx-auto px-6 py-12">
        <div class="grid sm:grid-cols-3 gap-10">
          {[
            {
              icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>`,
              color: "#4f46e5",
              title: "Secreto tributario garantizado",
              desc: "RUTs, CIs y montos son anonimizados automáticamente antes de llegar al modelo. Cumplimiento con Art. 47 Cód. Tributario y URCDP Ley 18.331.",
            },
            {
              icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>`,
              color: "#059669",
              title: "Fuentes verificables siempre",
              desc: "El asistente no inventa respuestas. Cada consulta está fundamentada en el corpus legislativo uruguayo con cita exacta a la norma.",
            },
            {
              icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>`,
              color: "#c8992a",
              title: "Acceso sin contraseña",
              desc: "Login con código OTP enviado al email. El primer acceso crea tu cuenta automáticamente. Sin formularios ni datos de tarjeta.",
            },
          ].map((f) => (
            <div class="flex gap-4">
              <div class="w-9 h-9 rounded-xl shrink-0 flex items-center justify-center mt-0.5"
                style={`color: ${f.color}; background: ${f.color}18;`}
                set:html={f.icon} />
              <div>
                <h3 class="font-semibold text-sm mb-1.5" style="color: #0f1117;">{f.title}</h3>
                <p class="text-sm leading-relaxed" style="color: #6b7280;">{f.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

  </div>

  <!-- Compliance section -->
  <section class="py-20" style="background-color: #131828;">
    <!-- Top gold line -->
    <div style="height: 1px; background: linear-gradient(90deg, transparent 0%, rgba(200,153,42,0.45) 50%, transparent 100%); margin-bottom: 0;"></div>
    <div class="max-w-5xl mx-auto px-6 pt-16">
      <div class="text-center mb-12">
        <span class="section-eyebrow mb-5" style="color: #6ee7b7; background: rgba(110,231,183,0.1);">
          Cumplimiento legal
        </span>
        <h2 class="font-display text-2xl sm:text-3xl font-bold mb-4 mt-4" style="font-family: var(--font-display), Georgia, serif; color: #f9fafb; letter-spacing: -0.02em;">
          Diseñado para cumplir la normativa uruguaya
        </h2>
        <p class="max-w-xl mx-auto text-sm" style="color: rgba(156,163,175,0.8); line-height: 1.7;">
          Requisitos legales no son opcionales — están integrados en la arquitectura del sistema.
        </p>
      </div>
      <div class="grid sm:grid-cols-3 gap-5">
        {[
          {
            title: "Art. 47 Código Tributario",
            desc: "Secreto tributario: la información de contribuyentes no puede ser divulgada. Adviser anonimiza RUTs, CIs y montos antes de cualquier procesamiento.",
            icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>`,
            accentColor: "rgba(165,180,252,0.9)",
            bgColor: "rgba(99,102,241,0.12)",
          },
          {
            title: "URCDP · Ley 18.331",
            desc: "Protección de datos personales: ningún dato identificable se almacena en vectores ni logs. La sanitización ocurre en memoria, antes de la inferencia.",
            icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`,
            accentColor: "rgba(110,231,183,0.9)",
            bgColor: "rgba(16,185,129,0.12)",
          },
          {
            title: "Respuestas Grounded",
            desc: "El modelo sólo puede responder desde el corpus normativo oficial ingresado. Sin alucinaciones: cada respuesta cita la fuente legislativa verificable.",
            icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>`,
            accentColor: "rgba(252,211,77,0.9)",
            bgColor: "rgba(200,153,42,0.14)",
          },
        ].map((item) => (
          <div class="flex flex-col gap-4 p-6 rounded-2xl" style={`background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);`}>
            <div class="w-10 h-10 rounded-xl flex items-center justify-center" style={`color: ${item.accentColor}; background: ${item.bgColor};`} set:html={item.icon} />
            <div>
              <h3 class="font-semibold mb-2" style="color: #f9fafb;">{item.title}</h3>
              <p class="text-sm leading-relaxed" style="color: rgba(156,163,175,0.8);">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="py-24" style="background-color: #f6f5f2;">
    <div class="max-w-5xl mx-auto px-6">
      <div class="text-center mb-16">
        <span class="section-eyebrow mb-5" style="color: #7c3aed; background: rgba(124,58,237,0.08);">Proceso</span>
        <h2 class="font-display text-2xl sm:text-3xl font-bold mb-3 mt-4" style="font-family: var(--font-display), Georgia, serif; color: #0f1117; letter-spacing: -0.02em;">¿Cómo funciona?</h2>
        <p class="text-sm" style="color: #6b7280;">Tres pasos para obtener asesoramiento tributario fundamentado.</p>
      </div>
      <ol class="grid sm:grid-cols-3 gap-12">
        {[
          { n: "01", title: "Ingresá tu email", desc: "Recibís un código OTP de un solo uso. No hace falta recordar contraseñas. El primer acceso crea tu cuenta automáticamente." },
          { n: "02", title: "Realizá tu consulta", desc: "Escribís tu pregunta sobre normativa DGI o BPS. Los datos sensibles (CI, RUT, montos) se redactan automáticamente." },
          { n: "03", title: "Respuesta fundamentada", desc: "La IA genera la respuesta basada exclusivamente en normativa oficial, con cita y enlace a la fuente legislativa." },
        ].map((step) => (
          <li class="flex flex-col gap-5">
            <div class="flex items-end gap-4">
              <span class="font-display text-5xl font-bold leading-none" style="font-family: var(--font-display), Georgia, serif; color: #c8992a; opacity: 0.75;">{step.n}</span>
              <div class="h-px flex-1 mb-2" style="background: linear-gradient(90deg, rgba(200,153,42,0.3), rgba(200,153,42,0.05));"></div>
            </div>
            <h3 class="font-semibold text-base" style="color: #0f1117;">{step.title}</h3>
            <p class="text-sm leading-relaxed" style="color: #6b7280;">{step.desc}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- CTA section -->
  <section id="acceso" class="py-24 text-white relative overflow-hidden"
    style="background: linear-gradient(135deg, #1e1b4b 0%, #312e81 35%, #4c1d95 70%, #1e1b4b 100%);">
    <!-- Grid overlay -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true"
      style="background-image: linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px); background-size: 72px 72px;"></div>
    <!-- Gold top line -->
    <div class="absolute top-0 inset-x-0 h-px" style="background: linear-gradient(90deg, transparent 0%, rgba(200,153,42,0.6) 50%, transparent 100%);"></div>
    <!-- Glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-150 h-100 pointer-events-none" aria-hidden="true"
      style="background: radial-gradient(ellipse, rgba(124,58,237,0.3) 0%, transparent 70%);"></div>

    <div class="relative max-w-2xl mx-auto px-6 text-center flex flex-col gap-7">
      <div class="flex justify-center gap-2 flex-wrap">
        <span class="text-xs px-3 py-1.5 rounded-full font-medium" style="background: rgba(255,255,255,0.1); color: rgba(196,181,253,0.9); border: 1px solid rgba(255,255,255,0.15);">Art. 47 Compliance</span>
        <span class="text-xs px-3 py-1.5 rounded-full font-medium" style="background: rgba(255,255,255,0.1); color: rgba(110,231,183,0.9); border: 1px solid rgba(255,255,255,0.15);">URCDP Ley 18.331</span>
        <span class="text-xs px-3 py-1.5 rounded-full font-medium" style="background: rgba(255,255,255,0.1); color: rgba(252,211,77,0.9); border: 1px solid rgba(255,255,255,0.15);">Cloudflare Edge</span>
      </div>
      <h2 class="font-display text-3xl sm:text-4xl font-bold" style="font-family: var(--font-display), Georgia, serif; letter-spacing: -0.02em;">Empezá ahora</h2>
      <p class="text-lg" style="color: rgba(196,181,253,0.8);">
        La primera vez que ingresás con tu email se crea tu cuenta automáticamente. Sin formularios ni contraseñas.
      </p>
      <div class="flex justify-center">
        <a
          href="/login"
          class="group inline-flex items-center gap-2.5 font-bold rounded-xl px-10 py-4 text-sm transition-all"
          style="background: white; color: #1e1b4b; box-shadow: 0 4px 24px rgba(0,0,0,0.3), 0 0 0 1px rgba(255,255,255,0.1);"
          onmouseover="this.style.background='#f0f0ff'; this.style.boxShadow='0 8px 40px rgba(0,0,0,0.35), 0 0 0 1px rgba(255,255,255,0.15)'; this.style.transform='translateY(-2px)';"
          onmouseout="this.style.background='white'; this.style.boxShadow='0 4px 24px rgba(0,0,0,0.3), 0 0 0 1px rgba(255,255,255,0.1)'; this.style.transform='';"
        >
          Acceder con email
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<script>
  // If already authenticated, update CTA to go directly to the app
  if (localStorage.getItem("adviser_session")) {
    const btn = document.getElementById("cta-btn") as HTMLAnchorElement | null;
    if (btn) {
      btn.href = "/app";
      btn.textContent = "Ir al asistente";
    }
  }
</script>
