---
import AppLayout from "../../layouts/AppLayout.astro";
---

<AppLayout title="Análisis Impositivo">
  <!-- Header -->
  <div class="flex items-start justify-between gap-4 flex-wrap">
    <div class="flex flex-col gap-1">
      <h1 class="text-2xl font-bold tracking-tight" style="color: #0f1117;">Análisis Impositivo</h1>
      <p class="text-sm" style="color: #6b7280; line-height: 1.6;">
        Gestioná períodos mensuales, subí documentos contables y obtenés un consolidado de tus impuestos más
        comunes (IVA, IRAE, IRPF, BPS y más).
      </p>
    </div>
    <button
      id="btn-new-period"
      class="flex items-center gap-2 text-sm font-medium rounded-xl px-4 py-2.5 transition-all whitespace-nowrap"
      style="background: #4f46e5; color: white; box-shadow: 0 2px 8px rgba(79,70,229,0.25);"
      onmouseover="this.style.background='#4338ca'; this.style.transform='translateY(-1px)';"
      onmouseout="this.style.background='#4f46e5'; this.style.transform='';"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
      </svg>
      Nuevo período
    </button>
  </div>

  <!-- Alert -->
  <div id="alert" class="hidden text-sm rounded-xl px-4 py-3"
    style="background: rgba(239,68,68,0.07); border: 1px solid rgba(239,68,68,0.25); color: #b91c1c;"></div>

  <!-- Loading skeleton -->
  <div id="loading" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {Array.from({ length: 3 }).map(() => (
      <div class="rounded-2xl p-5 animate-pulse" style="background: white; border: 1px solid rgba(0,0,0,0.07);">
        <div class="flex flex-col gap-3">
          <div class="h-4 rounded-lg w-2/3" style="background: #f3f4f6;"></div>
          <div class="h-3 rounded-lg w-1/3" style="background: #f3f4f6;"></div>
          <div class="h-8 rounded-lg w-full mt-2" style="background: #f3f4f6;"></div>
        </div>
      </div>
    ))}
  </div>

  <!-- Empty state -->
  <div id="empty-state" class="hidden text-center py-16 flex flex-col items-center gap-3">
    <div class="w-16 h-16 rounded-2xl flex items-center justify-center" style="background: rgba(79,70,229,0.07);">
      <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="color: #4f46e5;">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25ZM6.75 12h.008v.008H6.75V12Zm0 3h.008v.008H6.75V15Zm0 3h.008v.008H6.75V18Z" />
      </svg>
    </div>
    <p class="text-base font-semibold" style="color: #0f1117;">Sin períodos impositivos</p>
    <p class="text-sm max-w-xs" style="color: #6b7280;">Creá tu primer período mensual para empezar a subir documentos y obtener el análisis consolidado.</p>
    <button id="empty-btn-new" class="mt-2 text-sm font-medium transition-colors" style="color: #4f46e5;"
      onmouseover="this.style.color='#4338ca'" onmouseout="this.style.color='#4f46e5'">
      Crear primer período →
    </button>
  </div>

  <!-- Periods grid -->
  <div id="periods-grid" class="hidden grid sm:grid-cols-2 lg:grid-cols-3 gap-4"></div>
</AppLayout>

<!-- ── New Period Modal ─────────────────────────────────────── -->
<div id="modal-overlay" class="fixed inset-0 z-50 hidden items-center justify-center px-4"
  style="background: rgba(0,0,0,0.45); backdrop-filter: blur(6px);">
  <div class="w-full max-w-sm rounded-2xl p-6 flex flex-col gap-5"
    style="background: white; box-shadow: 0 24px 64px rgba(0,0,0,0.18);">
    <div class="flex items-center justify-between">
      <h2 class="text-base font-semibold" style="color: #0f1117;">Nuevo período impositivo</h2>
      <button id="modal-close" class="rounded-lg p-1 transition-colors" aria-label="Cerrar"
        style="color: #9ca3af;" onmouseover="this.style.background='#f3f4f6'" onmouseout="this.style.background='transparent'">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <div id="modal-alert" class="hidden text-xs rounded-lg px-3 py-2"
      style="background: rgba(239,68,68,0.07); border: 1px solid rgba(239,68,68,0.25); color: #b91c1c;"></div>
    <form id="new-period-form" class="flex flex-col gap-4">
      <div class="grid grid-cols-2 gap-3">
        <div class="flex flex-col gap-1.5">
          <label for="sel-month" class="text-xs font-medium" style="color: #374151;">Mes</label>
          <select id="sel-month" name="month"
            class="rounded-lg border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-white"
            style="color: #0f1117;">
            <option value="1">Enero</option>
            <option value="2">Febrero</option>
            <option value="3">Marzo</option>
            <option value="4">Abril</option>
            <option value="5">Mayo</option>
            <option value="6">Junio</option>
            <option value="7">Julio</option>
            <option value="8">Agosto</option>
            <option value="9">Septiembre</option>
            <option value="10">Octubre</option>
            <option value="11">Noviembre</option>
            <option value="12">Diciembre</option>
          </select>
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="sel-year" class="text-xs font-medium" style="color: #374151;">Año</label>
          <input type="number" id="sel-year" name="year" min="2000" max="2100"
            class="rounded-lg border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500"
            style="color: #0f1117;" />
        </div>
      </div>
      <button type="submit" id="modal-submit"
        class="w-full font-medium rounded-xl py-2.5 text-sm transition-all"
        style="background: #4f46e5; color: white; box-shadow: 0 2px 8px rgba(79,70,229,0.2);"
        onmouseover="this.style.background='#4338ca'" onmouseout="this.style.background='#4f46e5'">
        Crear período
      </button>
    </form>
  </div>
</div>

<!-- ── Confirm Delete Modal ─────────────────────────────────── -->
<div id="del-overlay" class="fixed inset-0 z-50 hidden items-center justify-center px-4"
  style="background: rgba(0,0,0,0.45); backdrop-filter: blur(6px);">
  <div class="w-full max-w-sm rounded-2xl p-6 flex flex-col gap-4"
    style="background: white; box-shadow: 0 24px 64px rgba(0,0,0,0.18);">
    <h2 class="text-base font-semibold" style="color: #0f1117;">¿Eliminar período?</h2>
    <p id="del-body" class="text-sm" style="color: #6b7280;"></p>
    <div class="flex gap-3 justify-end">
      <button id="del-cancel" class="text-sm font-medium px-4 py-2 rounded-xl transition-colors"
        style="border: 1px solid rgba(0,0,0,0.1); color: #374151;"
        onmouseover="this.style.background='rgba(0,0,0,0.04)'" onmouseout="this.style.background='transparent'">
        Cancelar
      </button>
      <button id="del-ok" class="text-sm font-medium px-4 py-2 rounded-xl text-white transition-colors"
        style="background: #dc2626;"
        onmouseover="this.style.background='#b91c1c'" onmouseout="this.style.background='#dc2626'">
        Eliminar
      </button>
    </div>
  </div>
</div>

<script>
  // ── Types ──────────────────────────────────────────────────────────────────
  interface TaxPeriod {
    id: string;
    month: number;
    year: number;
    label: string;
    status: "draft" | "analyzed";
    doc_count: number;
    created_at: number;
  }

  // ── Elements ───────────────────────────────────────────────────────────────
  const loadingEl  = document.getElementById("loading")       as HTMLDivElement;
  const emptyEl    = document.getElementById("empty-state")   as HTMLDivElement;
  const gridEl     = document.getElementById("periods-grid")  as HTMLDivElement;
  const alertEl    = document.getElementById("alert")         as HTMLDivElement;

  const btnNew     = document.getElementById("btn-new-period") as HTMLButtonElement;
  const emptyBtn   = document.getElementById("empty-btn-new") as HTMLButtonElement;

  // Modal elements
  const overlay    = document.getElementById("modal-overlay")   as HTMLDivElement;
  const modalClose = document.getElementById("modal-close")     as HTMLButtonElement;
  const modalForm  = document.getElementById("new-period-form") as HTMLFormElement;
  const modalAlert = document.getElementById("modal-alert")     as HTMLDivElement;
  const modalSubmit = document.getElementById("modal-submit")   as HTMLButtonElement;
  const selMonth   = document.getElementById("sel-month")       as HTMLSelectElement;
  const selYear    = document.getElementById("sel-year")        as HTMLInputElement;

  // Delete modal
  const delOverlay = document.getElementById("del-overlay") as HTMLDivElement;
  const delBody    = document.getElementById("del-body")    as HTMLParagraphElement;
  const delCancel  = document.getElementById("del-cancel")  as HTMLButtonElement;
  const delOk      = document.getElementById("del-ok")      as HTMLButtonElement;

  let pendingDeleteId    = "";
  let pendingDeleteLabel = "";

  // ── Helpers ────────────────────────────────────────────────────────────────
  const session = () => localStorage.getItem("adviser_session") ?? "";

  function authHeaders(): HeadersInit {
    return { Authorization: "Bearer " + session(), "Content-Type": "application/json" };
  }

  function showAlert(msg: string) {
    alertEl.textContent = msg;
    alertEl.classList.remove("hidden");
    setTimeout(() => alertEl.classList.add("hidden"), 6000);
  }

  function handleUnauth(status: number) {
    if (status === 401) {
      localStorage.removeItem("adviser_session");
      window.location.replace("/login?login=expired");
      return true;
    }
    return false;
  }

  // ── Default year to current ────────────────────────────────────────────────
  selYear.value = String(new Date().getFullYear());
  // Pre-select current month
  selMonth.value = String(new Date().getMonth() + 1);

  // ── Modal open/close ───────────────────────────────────────────────────────
  function openModal() {
    modalAlert.classList.add("hidden");
    overlay.classList.remove("hidden");
    overlay.classList.add("flex");
    selYear.focus();
  }

  function closeModal() {
    overlay.classList.add("hidden");
    overlay.classList.remove("flex");
    modalForm.reset();
    selYear.value = String(new Date().getFullYear());
    selMonth.value = String(new Date().getMonth() + 1);
  }

  btnNew?.addEventListener("click",    openModal);
  emptyBtn?.addEventListener("click",  openModal);
  modalClose?.addEventListener("click", closeModal);
  overlay?.addEventListener("click", (e) => { if (e.target === overlay) closeModal(); });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") { closeModal(); closeDelModal(); } });

  // ── Delete modal ───────────────────────────────────────────────────────────
  function openDelModal(id: string, label: string) {
    pendingDeleteId    = id;
    pendingDeleteLabel = label;
    delBody.textContent = `Esto eliminará el período "${label}" con todos sus documentos y análisis. No se puede deshacer.`;
    delOverlay.classList.remove("hidden");
    delOverlay.classList.add("flex");
  }

  function closeDelModal() {
    delOverlay.classList.add("hidden");
    delOverlay.classList.remove("flex");
    pendingDeleteId = "";
  }

  delCancel?.addEventListener("click", closeDelModal);
  delOverlay?.addEventListener("click", (e) => { if (e.target === delOverlay) closeDelModal(); });

  delOk?.addEventListener("click", async () => {
    if (!pendingDeleteId) return;
    const id    = pendingDeleteId;
    const label = pendingDeleteLabel;
    closeDelModal();

    const res = await fetch(`/api/tax/periods/${encodeURIComponent(id)}`, {
      method: "DELETE", headers: { Authorization: "Bearer " + session() },
    });
    if (handleUnauth(res.status)) return;
    if (!res.ok) {
      const e = await res.json().catch(() => ({})) as { error?: string };
      showAlert(e.error ?? "No se pudo eliminar el período.");
      return;
    }

    document.getElementById(`period-card-${id}`)?.remove();
    const remaining = gridEl.querySelectorAll("[id^='period-card-']").length;
    if (remaining === 0) {
      gridEl.classList.add("hidden");
      emptyEl.classList.remove("hidden");
    }
  });

  // ── Create period ──────────────────────────────────────────────────────────
  modalForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    modalAlert.classList.add("hidden");
    modalSubmit.disabled = true;
    modalSubmit.textContent = "Creando…";

    const body = JSON.stringify({ month: Number(selMonth.value), year: Number(selYear.value) });
    const res = await fetch("/api/tax/periods", { method: "POST", headers: authHeaders(), body });

    if (handleUnauth(res.status)) return;

    const data = await res.json() as { ok?: boolean; period?: TaxPeriod; error?: string };
    if (res.ok && data.period) {
      closeModal();
      prependCard(data.period);
      emptyEl.classList.add("hidden");
      gridEl.classList.remove("hidden");
    } else {
      modalAlert.textContent = data.error ?? "Error al crear el período.";
      modalAlert.classList.remove("hidden");
    }
    modalSubmit.disabled = false;
    modalSubmit.textContent = "Crear período";
  });

  // ── Render helpers ─────────────────────────────────────────────────────────
  const STATUS_BADGE: Record<string, string> = {
    draft:    "background: rgba(100,116,139,0.1); color: #475569;",
    analyzed: "background: rgba(16,185,129,0.1); color: #065f46;",
  };
  const STATUS_LABEL: Record<string, string> = {
    draft:    "Pendiente",
    analyzed: "Analizado",
  };

  function buildCard(p: TaxPeriod): HTMLElement {
    const card = document.createElement("div");
    card.id = `period-card-${p.id}`;
    card.className = "rounded-2xl p-5 flex flex-col gap-4 transition-shadow hover:shadow-md cursor-pointer";
    card.style.cssText = "background: white; border: 1px solid rgba(0,0,0,0.07); box-shadow: 0 1px 6px rgba(0,0,0,0.04);";

    const badgeStyle = STATUS_BADGE[p.status] ?? STATUS_BADGE.draft;
    const badgeLabel = STATUS_LABEL[p.status] ?? p.status;
    const docLabel   = p.doc_count === 1 ? "1 documento" : `${p.doc_count} documentos`;

    card.innerHTML = `
      <div class="flex items-start justify-between gap-2">
        <div class="flex flex-col gap-1">
          <span class="text-base font-semibold" style="color: #0f1117;">${p.label}</span>
          <span class="text-xs" style="color: #9ca3af;">${docLabel}</span>
        </div>
        <span class="text-xs font-medium px-2.5 py-1 rounded-full whitespace-nowrap flex-shrink-0" style="${badgeStyle}">${badgeLabel}</span>
      </div>
      <div class="flex gap-2 pt-1">
        <a href="/app/impuestos/periodo?id=${p.id}"
          class="flex-1 text-center text-xs font-medium py-2 rounded-lg transition-colors"
          style="background: rgba(79,70,229,0.07); color: #4f46e5;"
          onmouseover="this.style.background='rgba(79,70,229,0.14)'" onmouseout="this.style.background='rgba(79,70,229,0.07)'">
          ${p.status === "analyzed" ? "Ver análisis" : "Abrir período"}
        </a>
        <button class="del-period-btn text-xs font-medium px-3 py-2 rounded-lg transition-colors"
          data-id="${p.id}" data-label="${p.label.replace(/"/g, '&quot;')}"
          style="color: #dc2626; border: 1px solid rgba(220,38,38,0.2);"
          onmouseover="this.style.background='rgba(220,38,38,0.07)'" onmouseout="this.style.background='transparent'">
          Eliminar
        </button>
      </div>
    `;

    card.querySelector("a")?.addEventListener("click", (e) => e.stopPropagation());
    card.querySelector(".del-period-btn")?.addEventListener("click", (e) => {
      e.stopPropagation();
      const btn = e.currentTarget as HTMLElement;
      openDelModal(btn.dataset.id!, btn.dataset.label!);
    });
    card.addEventListener("click", () => {
      window.location.href = `/app/impuestos/periodo?id=${p.id}`;
    });

    return card;
  }

  function prependCard(p: TaxPeriod) {
    gridEl.prepend(buildCard(p));
  }

  // ── Load periods ───────────────────────────────────────────────────────────
  async function loadPeriods() {
    const res = await fetch("/api/tax/periods", { headers: { Authorization: "Bearer " + session() } });
    if (handleUnauth(res.status)) return;

    loadingEl.classList.add("hidden");

    if (!res.ok) { showAlert("No se pudieron cargar los períodos."); return; }

    const data = await res.json() as { periods: TaxPeriod[] };

    if (data.periods.length === 0) {
      emptyEl.classList.remove("hidden");
      return;
    }

    gridEl.innerHTML = "";
    for (const p of data.periods) {
      gridEl.appendChild(buildCard(p));
    }
    gridEl.classList.remove("hidden");
  }

  loadPeriods();
</script>
