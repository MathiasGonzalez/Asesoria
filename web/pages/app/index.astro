---
import AppLayout from "../../layouts/AppLayout.astro";
---

<AppLayout title="Asistente de Consultas">
  <div class="flex flex-col gap-1.5">
    <h1 class="text-2xl font-bold" style="color: #0f1117; letter-spacing: -0.02em;">Asistente Regulatorio DGI / BPS</h1>
    <p class="text-sm" style="color: #6b7280; line-height: 1.6;">
      Consultá normativa tributaria y de seguridad social en Uruguay. Los datos sensibles son
      anonimizados automáticamente antes del procesamiento.
    </p>
  </div>

  <!-- Search form -->
  <div class="flex flex-col gap-4 p-6" style="background: white; border-radius: 1rem; border: 1px solid rgba(0,0,0,0.07); box-shadow: 0 2px 12px rgba(0,0,0,0.05);">
    <form id="search-form" class="flex gap-2">
      <input
        type="text"
        id="query-input"
        placeholder="Ej: ¿Qué plazo tiene una auditoría fiscal de DGI?"
        class="grow rounded-xl px-4 py-2.5 text-sm transition-all focus:outline-none"
        style="border: 1.5px solid rgba(0,0,0,0.12); background: #fafaf9; color: #0f1117;"
        onfocus="this.style.borderColor='#4f46e5'; this.style.boxShadow='0 0 0 3px rgba(79,70,229,0.1)';"
        onblur="this.style.borderColor='rgba(0,0,0,0.12)'; this.style.boxShadow='none';"
        required
      />
      <button
        type="submit"
        id="submit-btn"
        class="text-white font-semibold rounded-xl px-5 py-2 text-sm transition-all whitespace-nowrap"
        style="background: #4f46e5; box-shadow: 0 2px 10px rgba(79,70,229,0.3);"
        onmouseover="this.style.background='#4338ca'; this.style.transform='translateY(-1px)';"
        onmouseout="this.style.background='#4f46e5'; this.style.transform='';"
      >
        Consultar
      </button>
    </form>
    <p class="text-xs flex items-center gap-1.5" style="color: #9ca3af;">
      <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 1a4.5 4.5 0 00-4.5 4.5V9H5a2 2 0 00-2 2v6a2 2 0 002 2h10a2 2 0 002-2v-6a2 2 0 00-2-2h-.5V5.5A4.5 4.5 0 0010 1zm3 8V5.5a3 3 0 10-6 0V9h6z" clip-rule="evenodd"/></svg>
      Tu consulta es anonimizada antes de ser procesada. No se envían CIs, RUTs ni montos al modelo.
    </p>
  </div>

  <!-- Loading -->
  <div id="loading" class="hidden text-center py-12 flex flex-col items-center gap-4">
    <div class="inline-block animate-spin rounded-full h-8 w-8" style="border: 2px solid rgba(79,70,229,0.15); border-bottom-color: #4f46e5;"></div>
    <p class="text-sm" style="color: #6b7280;">Analizando normativa y validando secreto tributario…</p>
  </div>

  <!-- Results -->
  <div id="results-card" class="hidden flex flex-col gap-4 p-6" style="background: white; border-radius: 1rem; border: 1px solid rgba(0,0,0,0.07); box-shadow: 0 2px 12px rgba(0,0,0,0.05);">
    <div class="flex justify-between items-center pb-3" style="border-bottom: 1px solid rgba(0,0,0,0.06);">
      <h2 class="font-semibold" style="color: #0f1117;">Respuesta del Asistente</h2>
      <span id="latency-tag" class="text-xs rounded-full px-2.5 py-1" style="color: #6b7280; background: #f3f4f6;"></span>
    </div>
    <div
      id="sanitized-alert"
      class="hidden text-xs rounded-xl p-3"
      style="background: rgba(251,191,36,0.1); border: 1px solid rgba(251,191,36,0.3); color: #92400e;"
    ></div>
    <div id="answer-content" class="text-sm leading-relaxed whitespace-pre-line" style="color: #374151;"></div>
  </div>

  <!-- Nav links -->
  <div class="flex gap-4 text-xs flex-wrap" style="color: #9ca3af;">
    <a href="/app/impuestos" class="transition-colors" style="color: #059669;"
      onmouseover="this.style.color='#047857'"
      onmouseout="this.style.color='#059669'">
      Análisis impositivo →
    </a>
    <a href="/app/ingest" class="transition-colors" style="color: #6b7280;"
      onmouseover="this.style.color='#4f46e5'"
      onmouseout="this.style.color='#6b7280'">
      Administrar documentos →
    </a>
  </div>
</AppLayout>

<script>
  const form        = document.getElementById("search-form") as HTMLFormElement | null;
  const loading     = document.getElementById("loading") as HTMLDivElement | null;
  const resultsCard = document.getElementById("results-card") as HTMLDivElement | null;
  const alertDiv    = document.getElementById("sanitized-alert") as HTMLDivElement | null;
  const answerEl    = document.getElementById("answer-content") as HTMLDivElement | null;
  const latencyTag  = document.getElementById("latency-tag") as HTMLSpanElement | null;
  const submitBtn   = document.getElementById("submit-btn") as HTMLButtonElement | null;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const input = document.getElementById("query-input") as HTMLInputElement;
    if (!input.value.trim()) return;

    loading?.classList.remove("hidden");
    resultsCard?.classList.add("hidden");
    alertDiv?.classList.add("hidden");
    if (submitBtn) submitBtn.disabled = true;

    try {
      const session = localStorage.getItem("adviser_session") ?? "";
      const response = await fetch(`/api/search?q=${encodeURIComponent(input.value.trim())}`, {
        headers: { Authorization: "Bearer " + session },
      });

      if (response.status === 401) {
        localStorage.removeItem("adviser_session");
        window.location.replace("/login?login=expired");
        return;
      }

      const data = await response.json() as {
        latencyMs: number;
        sanitizedQuery: string;
        originalQuery: string;
        response: string;
        error?: string;
      };

      if (!response.ok) {
        if (answerEl) answerEl.innerText = data.error ?? "Error procesando la consulta.";
        resultsCard?.classList.remove("hidden");
        return;
      }

      if (latencyTag) latencyTag.innerText = `${data.latencyMs}ms`;
      if (alertDiv && data.sanitizedQuery !== data.originalQuery) {
        alertDiv.innerText = `Consulta anonimizada: "${data.sanitizedQuery}"`;
        alertDiv.classList.remove("hidden");
      }
      if (answerEl) answerEl.innerText = data.response;
      resultsCard?.classList.remove("hidden");

    } catch {
      if (answerEl) answerEl.innerText = "Error procesando la consulta. Intentá nuevamente.";
      resultsCard?.classList.remove("hidden");
    } finally {
      loading?.classList.add("hidden");
      if (submitBtn) submitBtn.disabled = false;
    }
  });
</script>
